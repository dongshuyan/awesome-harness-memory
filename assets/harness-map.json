{
  "checked": "2026-11-07",
  "scope": "当前目录中已定位的 Harness 与 Agent；具体组件单独注明，历史对象仍可查看。不是整个行业的穷尽清单。",
  "dimensions": [
    {
      "id": "owner",
      "name": "记忆控制相关主体",
      "options": [
        {
          "id": "owner.human",
          "name": "用户设定",
          "definition": "人编写规则、选择记忆内容或控制记忆开关。"
        },
        {
          "id": "owner.agent",
          "name": "Agent 主动",
          "definition": "执行任务的 Agent 决定写入、修改或调用记忆工具；后台模型提炼不自动算作 Agent 主动。"
        },
        {
          "id": "owner.runtime",
          "name": "Harness 管理",
          "definition": "运行环境负责保存、压缩、加载或后台整理。"
        },
        {
          "id": "owner.external",
          "name": "外部记忆服务",
          "definition": "借助独立插件或服务管理记忆，需看具体集成条件。"
        }
      ]
    },
    {
      "id": "content",
      "name": "记忆内容与作用",
      "options": [
        {
          "id": "content.context",
          "name": "工作上下文",
          "definition": "当前任务要继续完成所需的信息，例如未完成步骤；不等同于全部历史。"
        },
        {
          "id": "content.events",
          "name": "经历与事件",
          "definition": "对话、工具活动或任务经历的记录。"
        },
        {
          "id": "content.facts",
          "name": "事实与偏好",
          "definition": "可在之后复用的事实、用户信息、偏好。"
        },
        {
          "id": "content.experience",
          "name": "经验与技能",
          "definition": "做事方法、反馈、已确认的经验或可复用技能；保存不保证实际学会。"
        },
        {
          "id": "content.rules",
          "name": "规则与约定",
          "definition": "人工编写的指令、项目规范或行为约定。"
        }
      ]
    },
    {
      "id": "scope",
      "name": "记忆组织范围",
      "options": [
        {
          "id": "scope.session",
          "name": "会话/任务",
          "definition": "同一会话或任务的状态，可包括恢复这一会话。"
        },
        {
          "id": "scope.project",
          "name": "项目/工作区",
          "definition": "围绕同一项目、仓库或工作目录组织。"
        },
        {
          "id": "scope.user",
          "name": "用户",
          "definition": "面向用户的配置或信息范围；不自动意味着安全隔离。"
        },
        {
          "id": "scope.agent",
          "name": "持续 Agent",
          "definition": "围绕持续的 Agent 身份组织，可跨会话。"
        }
      ]
    },
    {
      "id": "form",
      "name": "记忆表示与存储",
      "options": [
        {
          "id": "form.files",
          "name": "文件",
          "definition": "以文件、Markdown 笔记等形式承载。"
        },
        {
          "id": "form.records",
          "name": "结构化记录",
          "definition": "消息、事件、检查点或数据库记录；可与文件存储重叠。"
        },
        {
          "id": "form.vector",
          "name": "向量索引",
          "definition": "用语义向量为记忆建立检索索引，通常仍有原始内容。"
        },
        {
          "id": "form.graph",
          "name": "关系图谱",
          "definition": "显式组织实体和关系；目录树本身不算知识图谱。"
        }
      ]
    },
    {
      "id": "operation",
      "name": "记忆写入与维护",
      "options": [
        {
          "id": "operation.extract",
          "name": "提炼",
          "definition": "从对话或经历中提取值得以后保留的信息。"
        },
        {
          "id": "operation.compact",
          "name": "上下文压缩",
          "definition": "为当前模型输入缩短或替换旧上下文；不等于删除原始存档。"
        },
        {
          "id": "operation.update",
          "name": "修订",
          "definition": "编辑、替换或整合已有记忆。"
        },
        {
          "id": "operation.forget",
          "name": "删除/清理",
          "definition": "删除保存的记录或清理过时内容；具体删除范围需查依据。"
        }
      ]
    },
    {
      "id": "use",
      "name": "记忆检索与使用",
      "options": [
        {
          "id": "use.fixed",
          "name": "启动/固定载入",
          "definition": "启动或组装上下文时放入固定文件、索引或历史；不保证全文每轮都在。"
        },
        {
          "id": "use.demand",
          "name": "按需读取",
          "definition": "Agent 或用户需要时读取/搜索相关记忆。"
        },
        {
          "id": "use.auto",
          "name": "自动检索注入",
          "definition": "运行时按当前请求检索相关片段并加入上下文。"
        }
      ]
    },
    {
      "id": "governance",
      "name": "记忆权限与可信性",
      "options": [
        {
          "id": "governance.trace",
          "name": "来源/修改记录",
          "definition": "记录来源、修改时间或版本；具体是哪种见依据。"
        },
        {
          "id": "governance.access",
          "name": "作用域/权限",
          "definition": "具有记忆相关的访问范围或只读边界；不等于完整安全认证。"
        },
        {
          "id": "governance.control",
          "name": "记忆使用控制",
          "definition": "用户可禁用记忆、选择读写范围或控制删除；不等于完全阻止泄露。"
        }
      ]
    }
  ],
