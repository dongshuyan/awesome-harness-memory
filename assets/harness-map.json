  "systems": [
    {
      "id": "pi",
      "resourceId": "pi",
      "kind": "harness",
      "identitySource": "pi",
      "note": "原生会话与压缩；未据此推断有用户画像或外部长期记忆。",
      "historical": false,
      "claims": [
        {
          "status": "yes",
          "features": [
            "owner.runtime",
            "content.context",
            "content.events",
            "scope.session",
            "scope.project",
            "form.files",
            "form.records",
            "use.fixed"
          ],
          "note": "会话自动保存；活动分支和发现的上下文组成下一次模型输入，按工作目录恢复。",
          "section": "Continue or switch sessions / Manage conversation context",
          "source": "pi"
        },
        {
          "status": "yes",
          "features": [
            "operation.compact"
          ],
          "note": "旧历史可自动或手动摘要，保留近期消息；原始会话条目不会因此删除。",
          "section": "Manage conversation context",
          "source": "pi"
        },
        {
          "status": "yes",
          "features": [
            "owner.human",
            "operation.forget",
            "governance.control"
          ],
          "note": "用户可选择恢复、分支或删除会话；--no-session 可关闭持久化。",
          "section": "Choose how to branch / Control session storage",
          "source": "pi"
        }
      ]
    },
    {
      "id": "codex",
      "resourceId": "codex",
      "kind": "harness",
      "identitySource": "codex",
      "note": "图中自动记忆指本地主机的可选记忆功能，默认关闭；与 ChatGPT 网页记忆分开。",
      "historical": false,
      "claims": [
        {
          "status": "config",
          "features": [
            "owner.runtime",
            "content.context",
            "form.files",
            "operation.extract",
            "operation.update",
            "use.fixed"
          ],
          "note": "启用本地 memories 后，后台从合格历史聊天提炼并整合，后续会话可注入；不是每个聊天结束立即写入。",
          "section": "How local Codex memories work / Configure local memories",
          "source": "codex"
        },
        {
          "status": "yes",
          "features": [
            "owner.human",
            "content.rules"
          ],
          "note": "必需规则建议放在 AGENTS.md 或项目文档；自动记忆不能取代必需指令。",
          "section": "Memories 开头说明",
          "source": "codex"
        },
        {
          "status": "yes",
          "features": [
            "governance.control",
            "operation.forget"
          ],
          "note": "可设置全局开关、逐聊天读写控制，并删除选定机器上的本地记忆。",
          "section": "Control local memories per chat / app controls",
          "source": "codex"
        }
      ]
    },
    {
      "id": "claude-code",
      "resourceId": "claude-code",
      "kind": "harness",
      "identitySource": "claude-code",
      "note": "自动记忆以本地项目为主；自托管、后台或嵌套启动会话的默认设置有例外。",
      "historical": false,
      "claims": [
        {
          "status": "yes",
          "features": [
            "owner.human",
            "content.rules",
            "scope.user"
          ],
          "note": "人工指令可按项目、用户或组织设置，作为上下文加载，不是强制工具权限。",
          "section": "CLAUDE.md vs auto memory",
          "source": "claude-code"
        },
        {
          "status": "yes",
          "features": [
            "owner.agent",
            "owner.runtime",
            "content.context",
            "content.facts",
            "content.experience",
            "scope.project",
            "form.files",
            "operation.extract",
            "operation.update",
            "use.fixed",
            "use.demand"
          ],
          "note": "普通本地会话默认开启（自托管、后台或嵌套会话有例外）。Agent 写自动笔记；Harness 启动加载有长度上限的索引，详情文件按需读。笔记涵盖偏好、反馈、项目与引用。",
          "section": "Auto memory / How it works",
          "source": "claude-code"
        },
        {
          "status": "yes",
          "features": [
            "operation.forget",
            "governance.control"
          ],
          "note": "用户可编辑或删除笔记，也可关闭自动记忆。",
          "section": "Audit and edit your memory / How it works",
          "source": "claude-code"
        },
        {
          "status": "config",
          "features": [
            "governance.trace"
          ],
          "note": "对带 YAML frontmatter 的记忆文件，写入时记录 modified 时间；这是修改时间，不是事实出处。",
          "section": "Auto memory / How it works",
          "source": "claude-code"
        }
      ]
    },
    {
      "id": "openclaw",
      "resourceId": "openclaw",
      "kind": "agent",
      "identitySource": "openclaw",
      "note": "Markdown 是持久记忆主体；检索后端与个人/共享场景应按配置核对。",
      "historical": false,
      "claims": [
        {
          "status": "yes",
          "features": [
            "owner.agent",
            "owner.runtime",
            "content.context",
            "content.events",
            "content.facts",
            "scope.project",
            "form.files",
            "operation.extract",
            "operation.update",
            "use.fixed",
            "use.demand"
          ],
          "note": "工作区保存 USER.md、MEMORY.md 和每日笔记；会话加载部分文件，并可按需搜索和读取。整理会从日记提炼持久信息。",
          "section": "Memory files / Agent tools / dreaming",
          "source": "openclaw"
        },
        {
          "status": "config",
          "features": [
            "form.vector"
          ],
          "note": "检索可以用向量与文本索引；向量提供方和数据库能力需配置，也可只用文本检索。",
          "section": "PostgreSQL memory search",
          "source": "openclaw"
        },
        {
          "status": "yes",
          "features": [
            "governance.trace",
            "governance.access"
          ],
          "note": "工作区来源记录用于阻止不可信或缺少有效来源身份的文件自动进入记忆上下文；不是完整安全保证。",
          "section": "Memory provenance overview",
          "source": "openclaw"
        }
      ]
    },
    {
      "id": "hermes",
      "resourceId": "hermes",
      "kind": "agent",
      "identitySource": "hermes",
      "note": "记忆和技能机制按项目 README 记录；学习效果与用户建模质量未经独立测试。",
      "historical": false,
      "claims": [
        {
          "status": "yes",
          "features": [
            "owner.agent",
            "owner.runtime",
            "content.events",
            "content.experience",
            "form.files",
            "form.records",
            "operation.extract",
            "operation.update",
            "operation.compact",
            "use.demand"
          ],
          "note": "Agent 维护笔记和技能；FTS5 搜索旧会话并摘要，可用 /compress 压缩上下文。",
          "section": "A closed learning loop / Commands",
          "source": "hermes"
        },
        {
          "status": "yes",
          "features": [
            "content.facts",
            "scope.user"
          ],
          "note": "README 列明 MEMORY.md 与 USER.md；用户画像的更深推断另有 Honcho 集成。",
          "section": "Migrating / Memories",
          "source": "hermes"
        },
        {
          "status": "config",
          "features": [
            "owner.external"
          ],
          "note": "Honcho 是可选用户建模集成；不能把外部服务的全部能力算作 Hermes 原生能力。",
          "section": "A closed learning loop",
          "source": "hermes"
        }
      ]
    },
    {
      "id": "gemini-cli",
      "resourceId": "gemini-cli",
      "kind": "harness",
      "identitySource": "gemini-cli",
      "note": "此行核对 GEMINI.md 指令上下文；其他自动记忆机制及不同客户端不由此推断。",
      "historical": false,
      "claims": [
        {
          "status": "yes",
          "features": [
            "owner.human",
